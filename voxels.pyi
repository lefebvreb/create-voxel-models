from typing import Final, final

@final
class Color: ...

@final
class Model:
    def __new__(cls, /, name: str, dims: tuple[int, int, int], palette: Palette) -> Model: ...
    def put(self, /, pos: tuple[int, int, int], color: Color |None = None) -> None: ...

@final
class Node:
    def create_child_node(self, /, name: str, extra: dict[str, str] |None = None) -> Node: ...

@final
class Palette:
    def __getitem__(self, index: int, /) -> Color: ...
    def __len__(self, /) -> int: ...
    def __new__(cls, /) -> Palette: ...
    def add_color(self, /, rgb: tuple[int, int, int], *, roughness: float = 1.0, metallic: float = 0.0, ior: float = 1.5, transmission: float = 0.0, emissive: float = 0.0) -> Color: ...

@final
class Quat:
    IDENTITY: Final[Quat]
    def __mul__(self, other: object, /) -> Quat: ...
    def conjugate(self, /) -> Quat: ...
    @staticmethod
    def from_rotation_x(angle: float) -> Quat: ...
    @staticmethod
    def from_rotation_y(angle: float) -> Quat: ...
    @staticmethod
    def from_rotation_z(angle: float) -> Quat: ...

@final
class Scene:
    def __new__(cls, /) -> Scene: ...
    def create_root_node(self, /, name: str, extra: dict[str, str] |None = None) -> Node: ...

@final
class Vec3:
    ONES: Final[Vec3]
    ZERO: Final[Vec3]
    def __add__(self, other: object, /) -> Vec3: ...
    def __mul__(self, other: object, /) -> Vec3: ...
    def __neg__(self, /) -> Vec3: ...
    def __new__(cls, /, x: float, y: float, z: float) -> Vec3: ...
    def __sub__(self, other: object, /) -> Vec3: ...
    def __truediv__(self, other: object, /) -> Vec3: ...
    @property
    def x(self, /) -> float: ...
    @property
    def y(self, /) -> float: ...
    @property
    def z(self, /) -> float: ...
